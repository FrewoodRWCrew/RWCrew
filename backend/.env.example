# Copy this file to ".env" (in this same "backend" folder) and adjust the
# values for your own machine/deployment. ".env" itself is never committed
# to git (see ../.gitignore), since it can contain real secrets.

# Connection string for the PostgreSQL database. The default below matches
# the local development database started with "docker compose up -d db"
# from the repository's root folder.
DATABASE_URL=postgresql+pg8000://rwcrew:rwcrew_dev_password@localhost:5433/rwcrew

# The secret key used to sign login tokens. MUST be a long, random,
# private value in any real deployment — never reuse the example below.
# You can generate one yourself, for example by running:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-value-in-real-deployments

# Which website(s) the API should accept requests from. During local
# development this is the address the Next.js frontend runs on.
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Outgoing email via Resend (https://resend.com), used e.g. to notify the
# Intervention Requests mailing list about every new request. Leave
# RESEND_API_KEY empty to skip sending (local development). MAIL_FROM's
# domain must be verified in Resend; "onboarding@resend.dev" works for a
# quick test but only delivers to the Resend account owner's own address.
RESEND_API_KEY=
MAIL_FROM=RWCrew <noreply@rwcrew.eu>
# Optional: prefix for every subject (e.g. "[TEST] " on the test server).
MAIL_SUBJECT_PREFIX=
# Public address of the web app, for links inside mails (empty = no link).
APP_PUBLIC_URL=http://localhost:3000
