# Copy this file to ".env" inside /opt/rwcrew/production on the VPS (never
# commit the real ".env" — it holds real secrets). Used by
# `docker compose -f docker-compose.prod.yml`. See
# docs/deploying-to-hostinger.pdf, Step 6.

POSTGRES_USER=rwcrew
POSTGRES_PASSWORD=replace-with-a-long-random-value
POSTGRES_DB=rwcrew

DATABASE_URL=postgresql+pg8000://rwcrew:replace-with-a-long-random-value@db:5432/rwcrew

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-value

CORS_ALLOWED_ORIGINS=["https://rwcrew.eu","https://www.rwcrew.eu"]

# Same hostname the browser uses to open the site — API routes are reverse
# proxied under the same origin at /api/*, so no separate api.* subdomain
# and no cross-site cookie issues (see CLAUDE.md's hostname-matching
# gotcha). NOTE: NEXT_PUBLIC_API_URL is a single fixed origin baked in at
# build time, so if the site is ever reachable under a second hostname
# (e.g. a "www" alias), CORS_ALLOWED_ORIGINS above must list that origin
# too, even though this value itself only names one of them.
NEXT_PUBLIC_API_URL=https://rwcrew.eu

# The public address printed into the QR codes of karbladen (Kar Planning ->
# Afdrukken). Baked in at build time like NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_SITE_URL=https://rwcrew.eu

# Host ports the Nginx reverse proxy forwards to (127.0.0.1-only — never
# exposed directly to the internet). Production and test MUST use different
# values since both run on the same VPS.
BACKEND_PORT=8020
FRONTEND_PORT=3000

# Phone app (see mobile/README.md "Releasing Android"). The APK itself lives in
# /opt/rwcrew/production/downloads/ and is served by Nginx under /downloads/.
# Changing these only needs: docker compose up -d backend (no rebuild).
MOBILE_MIN_APP_VERSION=0.0.0
MOBILE_ANDROID_DOWNLOAD_URL=https://rwcrew.eu/downloads/rwcrew-latest.apk
MOBILE_IOS_TESTFLIGHT_URL=
MOBILE_LATEST_VERSION=1.0.0
# One change per line; use \n between lines inside the double quotes.
MOBILE_CHANGELOG="First version\nLogin and module overview\nInterventie Aanvragen: KPI overview and actions"
