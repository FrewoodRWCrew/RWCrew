# Copy this file to ".env" inside /opt/rwcrew/test on the VPS (never commit
# the real ".env" — it holds real secrets). Used by
# `docker compose -f docker-compose.prod.yml`. See
# docs/deploying-to-hostinger.pdf, Step 6.

POSTGRES_USER=rwcrew
POSTGRES_PASSWORD=replace-with-a-different-long-random-value
POSTGRES_DB=rwcrew

DATABASE_URL=postgresql+pg8000://rwcrew:replace-with-a-different-long-random-value@db:5432/rwcrew

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# MUST be different from production's JWT_SECRET.
JWT_SECRET=replace-with-a-different-long-random-value

CORS_ALLOWED_ORIGINS=["https://test.rwcrew.eu","https://www.test.rwcrew.eu"]

NEXT_PUBLIC_API_URL=https://test.rwcrew.eu
NEXT_PUBLIC_SITE_URL=https://test.rwcrew.eu

# Shows a "this isn't production" warning banner on every page — see
# src/lib/config.ts / src/app/layout.tsx. Left unset in production.
NEXT_PUBLIC_ENVIRONMENT_LABEL=TEST

# Different from production's ports — both stacks run on the same VPS.
BACKEND_PORT=8120
FRONTEND_PORT=3100
# Database port on the VPS's 127.0.0.1, for pgAdmin via SSH tunnel (debugging).
DB_HOST_PORT=5442

# Phone app (see mobile/README.md "Releasing Android"). The APK itself lives in
# /opt/rwcrew/test/downloads/ and is served by Nginx under /downloads/.
# Changing these only needs: docker compose up -d backend (no rebuild).
MOBILE_MIN_APP_VERSION=0.0.0
MOBILE_ANDROID_DOWNLOAD_URL=https://test.rwcrew.eu/downloads/rwcrew-test-latest.apk
MOBILE_IOS_TESTFLIGHT_URL=
MOBILE_LATEST_VERSION=1.0.0
# One change per line; use \n between lines inside the double quotes.
MOBILE_CHANGELOG="First version\nLogin and module overview\nInterventie Aanvragen: KPI overview and actions"
