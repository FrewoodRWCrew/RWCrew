# Copy this file to ".env" inside /opt/rwcrew/test on the VPS (never commit
# the real ".env" — it holds real secrets). Used by
# `docker compose -f docker-compose.prod.yml`. See
# docs/deploying-to-hostinger.pdf, Step 6.

POSTGRES_USER=rwcrew
POSTGRES_PASSWORD=replace-with-a-different-long-random-value
POSTGRES_DB=rwcrew

DATABASE_URL=postgresql+pg8000://rwcrew:replace-with-a-different-long-random-value@db:5432/rwcrew

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# MUST be different from production's JWT_SECRET.
JWT_SECRET=replace-with-a-different-long-random-value

CORS_ALLOWED_ORIGINS=["https://test.rwcrew.eu"]

NEXT_PUBLIC_API_URL=https://test.rwcrew.eu

# Different from production's ports — both stacks run on the same VPS.
BACKEND_PORT=8120
FRONTEND_PORT=3100
