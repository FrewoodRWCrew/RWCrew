# Copy this file to /etc/tagscan-watcher/dev.env and again to
# /etc/tagscan-watcher/prod.env, filling in each environment's own values —
# see README.md. Never put a production API key in the dev file or vice
# versa: dev and prod are separate backend deployments with separate
# databases, so a scanner's API key is only ever valid on the one
# environment it was generated on.

# The device-intake upload endpoint of the target TagScan backend — copy
# this from that environment's own Settings screen ("Device upload URL").
API_URL=https://staging.example.com/api/public/tagscan-intake

# This device's API key — generate it on that environment's own Scanners
# screen ("Generate API key" on the relevant scanner row). Shown once at
# generation time; if lost, generate a new one (it invalidates this one).
API_KEY=module1_12_REPLACE-WITH-THE-GENERATED-KEY

# Local folders on this Pi. Point the producing app's output at
# WATCH_DIR (writing "file.csv.tmp" then rename()-ing to "file.csv" when
# done); this watcher moves each successfully-uploaded file into SENT_DIR.
WATCH_DIR=/home/pi/tagscan/dev/outgoing
SENT_DIR=/home/pi/tagscan/dev/sent

# How often (in seconds) to check WATCH_DIR for finished files.
POLL_INTERVAL_SECONDS=15
