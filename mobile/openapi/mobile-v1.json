      "TeamKarMemberOptionResponse": {
        "description": "One current TeamKar member, as shown in the Intervention Requests\nscreen's \"Team Kar\" dropdown \u2014 just enough to populate it (id + name).\nGated by Intervention Requests' own \"requests\" screen permission, not\nTeamKar's own, the same reasoning as the \"teams\" endpoint below: a user\ncan always pick a Team Kar member here regardless of whether they also\nhave the TeamKar screen's permission.",
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "display_name"
        ],
        "title": "TeamKarMemberOptionResponse",
        "type": "object"
      },
      "ValidationError": {
