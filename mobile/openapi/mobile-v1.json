            "type": "integer"
          },
          "team_cart_user_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Team Cart User Id"
          },
          "team_id": {
            "anyOf": [
              {
