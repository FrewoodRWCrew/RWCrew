            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "RW Crew mobile API",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/mobile/v1/auth/login": {
      "post": {
        "description": "Check an email/password combination and hand back tokens in the body.",
        "operationId": "mobile_login_api_mobile_v1_auth_login_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MobileTokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Mobile Login",
        "tags": [
          "mobile-auth"
        ]
      }
    },
    "/api/mobile/v1/auth/logout": {
      "post": {
        "description": "Revoke the phone's refresh token so it can never be used again.",
        "operationId": "mobile_logout_api_mobile_v1_auth_logout_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MobileRefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "boolean"
                  },
                  "title": "Response Mobile Logout Api Mobile V1 Auth Logout Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Mobile Logout",
        "tags": [
          "mobile-auth"
        ]
      }
    },
    "/api/mobile/v1/auth/me": {
      "get": {
        "description": "Who is logged in, and which modules can they open (Bearer token required).",
        "operationId": "mobile_me_api_mobile_v1_auth_me_get",
        "parameters": [
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Mobile Me",
        "tags": [
          "mobile-auth"
        ]
      }
    },
    "/api/mobile/v1/auth/refresh": {
      "post": {
        "description": "Swap a valid refresh token for a brand-new access + refresh token.",
        "operationId": "mobile_refresh_api_mobile_v1_auth_refresh_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
