      "InterventionRequestsDashboardResponse": {
        "description": "Aggregate KPI stats for Intervention Requests' landing dashboard\n(\"KPI overview\").",
        "properties": {
          "closed_requests": {
            "title": "Closed Requests",
            "type": "integer"
          },
          "open_requests": {
            "title": "Open Requests",
            "type": "integer"
          },
          "status_breakdown": {
            "items": {
              "$ref": "#/components/schemas/InterventionRequestsStatusBreakdownItem"
            },
