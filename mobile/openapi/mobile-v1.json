      },
      "MobileModule3PermissionsResponse": {
        "description": "What the calling user may do on the phone's Intervention Requests\n\"Akties\" screen, so the app only shows buttons the web roles allow.\n(There is no delete flag: deleting is web-only.)",
        "properties": {
          "can_create_requests": {
            "title": "Can Create Requests",
            "type": "boolean"
          },
          "can_edit_requests": {
            "title": "Can Edit Requests",
            "type": "boolean"
          },
          "can_view_requests": {
            "title": "Can View Requests",
            "type": "boolean"
          }
        },
        "required": [
          "can_view_requests",
          "can_create_requests",
          "can_edit_requests"
        ],
        "title": "MobileModule3PermissionsResponse",
        "type": "object"
      },
      "MobileRefreshRequest": {
        "description": "What the phone sends to swap its refresh token for a fresh pair.\n\nThe web app keeps this token in a cookie; the phone has no cookie jar,\nso it stores the token in the device's secure storage and sends it here.",
        "properties": {
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ],
        "title": "MobileRefreshRequest",
        "type": "object"
      },
      "MobileTokenResponse": {
        "description": "The tokens (plus who the user is) handed back after login/refresh.",
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "title": "Expires In",
            "type": "integer"
          },
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          },
          "token_type": {
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          },
