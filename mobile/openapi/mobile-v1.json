    "schemas": {
      "CurrentUserResponse": {
        "description": "What we tell the frontend about the currently logged-in user.",
        "properties": {
          "accessible_module_keys": {
            "items": {
              "type": "string"
            },
            "title": "Accessible Module Keys",
            "type": "array"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "is_super_admin": {
            "title": "Is Super Admin",
            "type": "boolean"
          },
          "language_preference": {
            "title": "Language Preference",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "display_name",
          "is_super_admin",
          "language_preference",
          "accessible_module_keys"
