# expo-router pulls in a web-only react-dom@19.3 whose peer dependency asks for
# React 19.3, while React Native 0.86 (Expo SDK 57) pins React 19.2.3. Only web
# builds use react-dom, so npm's strict peer check is switched off for this
# project. Re-check when upgrading the Expo SDK; the setting may then go away.
legacy-peer-deps=true
